# GroupEvent Environment Configuration Example

# Environment
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-key-in-production
APP_BASE_URL=https://group.oussamma.tn

# Database (PostgreSQL)
POSTGRES_USER=groupevent_user
POSTGRES_PASSWORD=groupevent_secret_pass_2026
POSTGRES_DB=groupevent_db
DATABASE_URL=postgresql+asyncpg://groupevent_user:groupevent_secret_pass_2026@postgres:5432/groupevent_db
DATABASE_URL_SYNC=postgresql://groupevent_user:groupevent_secret_pass_2026@postgres:5432/groupevent_db

# Redis Cache & Sessions
REDIS_URL=redis://redis:6379/0

# SSO Authentication (sso-a.oussamma.tn)
SSO_ISSUER=https://sso-a.oussamma.tn
SSO_CLIENT_ID=client_groupevent_app
SSO_CLIENT_SECRET=sec_groupevent_platform_secret_2026
SSO_REDIRECT_URI=https://group.oussamma.tn/auth/callback

# LiteLLM AI Service
LITELLM_BASE_URL=https://ai.oussamma.tn/v1
LITELLM_API_KEY=sk-oussamma-master-gateway-2026
LITELLM_MODEL=gpt-4o-mini

# Drive Receipts Storage
DRIVE_API_URL=https://drive.oussamma.tn
DRIVE_API_KEY=drv-master-key-2026

# Central Supervisor Service
SUPERVISOR_API_URL=https://supervisor.oussamma.tn
SUPERVISOR_API_KEY=sup-event-key-2026
STORAGE_DIR=/data/storage
